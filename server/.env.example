# Required
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/meta-crm
JWT_SECRET=change-me-to-a-long-random-string
META_VERIFY_TOKEN=your-webhook-verify-token

# Meta (optional until configured)
